{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": ["Bash(rm:*)", "Bash(rmdir:*)"],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "theme": "dark-ansi"
}
