#!/bin/bash

# Sketchybar main configuration
# Rose Pine theme, matching nvim & kitty

# Bar appearance
bar=(
  position=top
  height=24
  color=0x00000000
  padding_left=0
  padding_right=0
  margin=0
  corner_radius=0
  blur_radius=0
)
sketchybar --bar "${bar[@]}"

# Default item styling
defaults=(
  padding_left=4
  padding_right=4
  icon.font="FantasqueSansM Nerd Font Mono:Regular:14.0"
  label.font="FantasqueSansM Nerd Font Mono:Regular:14.0"
  icon.color=0xffe0def4
  label.color=0xffe0def4
  background.color=0x00000000
  background.corner_radius=4
  background.padding_left=4
  background.padding_right=4
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${defaults[@]}"

# Aerospace workspaces (1-5) - using item type, not space type
for sid in $(seq 1 5); do
  space=(
    label="$sid"
    label.font="FantasqueSansM Nerd Font Mono:Bold:14.0"
    label.color=0xff6e6a86
    background.color=0x00000000
    background.corner_radius=4
    background.padding_left=4
    background.padding_right=4
    label.padding_left=4
    label.padding_right=4
    click_script="aerospace workspace $sid"
  )
  sketchybar --add item space.$sid left --set space.$sid "${space[@]}"
done

# Background aerospace updater - loops every 100ms for instant workspace highlighting
# sketchybar's update_freq only supports integers, so we use a background loop
LOOP_PID_FILE="/tmp/sketchybar_aerospace_loop.pid"
if [ -f "$LOOP_PID_FILE" ]; then
  kill "$(cat "$LOOP_PID_FILE")" 2>/dev/null
fi
(
  while pgrep -x sketchybar > /dev/null 2>&1; do
    "$CONFIG_DIR/plugins/aerospace.sh"
    sleep 0.1
  done
) &
echo $! > "$LOOP_PID_FILE"

# Clock (top right)
clock=(
  update_freq=10
  script="$CONFIG_DIR/plugins/clock.sh"
  label.color=0xffe0def4
  label.font="FantasqueSansM Nerd Font Mono:Regular:14.0"
)
sketchybar --add item clock right --set clock "${clock[@]}"

# Force initial updates
sketchybar --update
