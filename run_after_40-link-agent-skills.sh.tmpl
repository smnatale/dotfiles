#!/bin/sh
set -eu

shared="{{ .chezmoi.homeDir }}/.agents/skills"
claude="{{ .chezmoi.homeDir }}/.claude/skills"

[ -d "$shared" ] || exit 0
mkdir -p "$claude"

link_if_missing() {
	link_source=$1
	link_target=$2

	if [ -L "$link_target" ] && [ "$(readlink "$link_target")" = "$link_source" ]; then
		return
	fi
	if [ -e "$link_target" ] || [ -L "$link_target" ]; then
		printf 'Not replacing conflicting path: %s\n' "$link_target" >&2
		return
	fi

	ln -s "$link_source" "$link_target"
}

for skill in "$shared"/*; do
	[ -d "$skill" ] || continue

	name=${skill##*/}
	link_if_missing "$skill" "$claude/$name"
done

link_if_missing "$HOME/AGENTS.md" "$HOME/CLAUDE.md"
