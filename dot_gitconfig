[user]
	name = smnatale
  email = 66391194+smnatale@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[core]
	# neovim btw
	editor = nvim
[init]
  defaultBranch = main
[pull]
  rebase = true
[push]
  autoSetupRemote = true
[branch]
	# list branches by most recent commit.
  sort = -committerdate
[checkout]
	defaultRemote = origin
[fetch]
  # remove remote-tracking branches that no longer exist upstream
  prune = true
[rerere]
  # reuse recorded conflict resolutions automatically
  enabled = true
[merge]
	# include the common ancestor in conflict markers for easier resolution
  conflictStyle = zdiff3
