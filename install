#!/usr/bin/env bash
set -euo pipefail

# Dotfiles installer. Idempotent: safe to run after git pull.
# Usage: ./install

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir"

die() { echo "install: $*" >&2; exit 1; }
info() { echo "==> $*"; }

stow_packages=(
  aerospace
  bat
  claude
  codex
  ghostty
  nvim
  nvim_nightly
  opencode
  sketchybar
  tmux
  tuicr
  vicinae
  workmux
  zsh
)

check() {
  local failed=0

  if command -v brew >/dev/null 2>&1; then
    if brew bundle check --file="$script_dir/Brewfile" >/dev/null 2>&1; then
      echo "ok: Homebrew dependencies"
    else
      echo "missing: Homebrew dependencies"
      failed=1
    fi
  else
    echo "missing: Homebrew"
    failed=1
  fi

  if command -v stow >/dev/null 2>&1; then
    if stow --simulate --target="$HOME" "${stow_packages[@]}" >/dev/null 2>&1; then
      echo "ok: Stow packages"
    else
      echo "conflict: Stow packages"
      failed=1
    fi
  else
    echo "missing: Stow"
    failed=1
  fi

  if bash -n install bin/agent-share symlink-skills.sh tmux/.config/tmux/*.sh \
    sketchybar/.config/sketchybar/*.sh sketchybar/.config/sketchybar/plugins/*.sh \
    claude/.claude/statusline-command.sh; then
    echo "ok: Bash syntax"
  else
    echo "failed: Bash syntax"
    failed=1
  fi

  if zsh -n zsh/.zshenv zsh/.zshrc zsh/.p10k.zsh; then
    echo "ok: Zsh syntax"
  else
    echo "failed: Zsh syntax"
    failed=1
  fi

  return "$failed"
}

case "${1:-}" in
  --check)
    check
    exit "$?"
    ;;
  "")
    ;;
  *)
    die "usage: $0 [--check]"
    ;;
esac

# ---------------------------------------------------------------------------
# 1. Homebrew
# ---------------------------------------------------------------------------
if ! command -v brew >/dev/null 2>&1; then
  info "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

info "Installing brew dependencies..."
brew bundle --file="$script_dir/Brewfile"

# Check whether a stow package appears to already be stowed (at least one
# expected symlink exists in home pointing back into this repo).
is_stowed() {
  local pkg="$1"
  local pkg_file
  while IFS= read -r pkg_file; do
    local home_file="$HOME/${pkg_file#$pkg/}"
    if [[ -L "$home_file" ]]; then
      local target
      target="$(readlink "$home_file")"
      [[ "$target" == "$script_dir/"* ]] && return 0
    fi
  done < <(find "$pkg" -maxdepth 3 -type f | head -20)
  return 1
}

info "Stowing packages..."
failed=0
for pkg in "${stow_packages[@]}"; do
  if [[ ! -d "$pkg" ]]; then
    echo "  missing: $pkg" >&2
    failed=1
    continue
  fi

  if is_stowed "$pkg"; then
    if stow --restow -t "$HOME" "$pkg"; then
      echo "  restowed: $pkg"
    else
      echo "  conflict: $pkg" >&2
      failed=1
    fi
  else
    if stow -t "$HOME" "$pkg" 2>/dev/null; then
      echo "  stowed: $pkg"
    else
      echo "  conflict: $pkg" >&2
      echo "           Run: stow --adopt -t \"$HOME\" $pkg   (moves your existing file into the repo)" >&2
      echo "           Or:  rm ~/$(find "$pkg" -maxdepth 1 | head -1 | sed "s|^$pkg/||")   (if you don't need the existing file)" >&2
      failed=1
    fi
  fi
done

if (( failed != 0 )); then
  die "stowing failed; resolve the conflicts above and rerun"
fi

# ---------------------------------------------------------------------------
# 3. Agent shared content
# ---------------------------------------------------------------------------
info "Syncing agent shared content..."
"$script_dir/bin/agent-share" sync

# ---------------------------------------------------------------------------
# 4. Shell
# ---------------------------------------------------------------------------
if [[ "$SHELL" != *"/zsh" ]]; then
  info "Changing default shell to zsh..."
  chsh -s "$(which zsh)"
fi

info "Done."
echo ""
echo "Next steps:"
echo "  - Restart your terminal or run: source ~/.zshrc"
echo "  - Verify the setup later with: ./install --check"
